# Chaves da Stripe (obtenha em https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Segredo do webhook (dado pela Stripe CLI: `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs das subscrições mensais (crie os produtos no Dashboard da Stripe)
# Pro = 9,99 €/mês · Premium = 24,99 €/mês
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# URL do frontend (para CORS e redirects de sucesso/cancelamento)
CLIENT_URL=http://localhost:5173

# Porta do servidor
PORT=4242
